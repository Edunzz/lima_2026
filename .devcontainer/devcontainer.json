{
  "name": "Lab Lima 2026 — Dynatrace Agentic Observability",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  // dtctl guarda el token OAuth en archivo: el contenedor es headless y no
  // tiene keyring (ni D-Bus), así que el backend por defecto falla.
  "containerEnv": {
    "DTCTL_TOKEN_STORAGE": "file"
  },

  // El puerto del callback OAuth es aleatorio: que se reenvíe solo y sin avisos.
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  },

  // SIN features a propósito: declararlas obliga a construir una imagen
  // derivada dentro del disco del codespace, que es lo que hacía lenta la
  // creación. La imagen base ya trae git, curl y wget, que es todo lo que
  // necesita postCreate.sh; y el laboratorio en sí solo usa dtctl, las skills
  // dt-* y Copilot. Node, Python y gh no hacen falta para ningún paso.
  "features": {},

  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "chat.agent.enabled": true,
        "github.copilot.chat.codeGeneration.useInstructionFiles": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  // 3232 es el puerto del callback OAuth de dtctl (redirect_uri fijo). Se
  // reenvía desde el principio para que aparezca en la pestaña PORTS y se
  // pueda completar el login desde el Codespace abierto en el navegador.
  "forwardPorts": [8000, 3232],
  "portsAttributes": {
    "8000": { "label": "Guía del Lab (steps.md)", "onAutoForward": "openPreview" },
    "3232": { "label": "Login de dtctl (callback OAuth)", "onAutoForward": "silent" }
  }
}
